# ── Autenticación (Sistema de Finanzas) ─────────────────────────────────────
# Define AUTH_USERNAME y AUTH_PASSWORD para PROTEGER la app. Si no las defines,
# la autenticación queda deshabilitada y todo está abierto (útil en dev local).

# Usuario permitido para iniciar sesión.
AUTH_USERNAME=admin

# Contraseña permitida (cámbiala por una segura).
AUTH_PASSWORD=tu-contraseña-ultra-secreta

# Secreto para firmar los JWT (usa una cadena larga y aleatoria, >= 32 chars).
# Genera uno con: openssl rand -base64 48
AUTH_TOKEN_SECRET=cambia-este-secreto-por-uno-aleatorio-y-largo

# Duración del access token (ms). Default: 5 min.
# ACCESS_TOKEN_TTL_MS=300000

# Duración del refresh token sin "Recuérdame" (ms). Default: 1 h.
# REFRESH_TTL_SHORT_MS=3600000

# Duración del refresh token con "Recuérdame" (ms). Default: 30 días.
# REFRESH_TTL_LONG_MS=2592000000

# Marca las cookies como Secure (solo HTTPS). Ponlo en 'true' si sirves por HTTPS.
# AUTH_COOKIE_SECURE=false
