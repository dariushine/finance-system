# ===========================================
# Sistema de Finanzas - Git Ignore
# Solo archivos esenciales para producción
# ===========================================

# --------------------------
# Node.js / npm
# --------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# --------------------------
# Environment
# --------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --------------------------
# Build outputs
# --------------------------
dist/
build/
.out/
.next/
.cache/
coverage/
.nyc_output/

# --------------------------
# Database
# --------------------------
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db.backup.*
backend/data/*.db.BAK-*
backend/data/backup/
*.db
*.db-journal
*.db.backup.*
*.db.BAK-*

# --------------------------
# OS generated files
# --------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------
# IDE
# --------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# --------------------------
# Logs
# --------------------------
*.log
logs/

# --------------------------
# Development files (NO mover a producción)
# --------------------------
test-*.js
test-*.sh
simple-*.js
src/robust-server.ts
src/simple-server.ts
src/complete-server.ts
src/correct-transaction-server.js
exchange-server.js
simple-transaction-server.js
simple-test.js
test-server.js
test-transaction.js
test-simple.sh
start-all.sh
# NOTA: __tests__/ (tests unitarios Jest del backend) SÍ se versionan.

# --------------------------
# Docker (opcional)
# --------------------------
.dockerignore

